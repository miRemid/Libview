# Dev: the app talks to PocketBase on the same host, port 8090.
# Production Docker SPA is served by PocketBase itself, so it uses the current origin.
# VITE_PB_URL=http://127.0.0.1:8090

# ImgBed (PocketBase hooks). docker compose passes these through.
IMGBED_URL=https://your-imgbed.example
IMGBED_TOKEN=

# PocketBase superuser / Libview admin login. Applied on every container start.
PB_ADMIN_EMAIL=admin@libview.local
PB_ADMIN_PASSWORD=change-me-please
