{
  "name": "libview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n worker,web -c cyan,green \"npm run worker:dev\" \"vite --host\"",
    "web": "vite --host",
    "worker:dev": "node scripts/ensure-dist.mjs && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute libview --local --file=worker/schema.sql",
    "d1:migrate": "wrangler d1 execute libview --remote --file=worker/schema.sql",
    "pb": "pocketbase serve --dir ./pocketbase/pb_data --migrationsDir ./pocketbase/pb_migrations --hooksDir ./pocketbase/pb_hooks --http=0.0.0.0:8090 --automigrate=false",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed:unsplash": "node scripts/seed-unsplash.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "exifr": "^7.1.3",
    "pocketbase": "^0.28.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.45.0"
  }
}
